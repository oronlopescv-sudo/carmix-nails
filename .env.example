# ============================================================
# CARMIX NAILS — variáveis de ambiente
# Copie este ficheiro para .env e preencha os valores reais.
# Nunca commitar o .env com segredos reais.
# ============================================================

# --- Base de dados PostgreSQL (obrigatório) ---
# Exemplo local:     postgresql://carmix:carmix@localhost:5433/carmix
# Exemplo Supabase:  postgresql://postgres:[PALAVRA]@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://carmix:carmix@localhost:5433/carmix"

# URL público do site (usado em links de e-mail, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- E-mail transacional (Resend) ---
# Sem RESEND_API_KEY o sistema continua a funcionar; os e-mails não são
# enviados e o painel mostra um aviso claro no ambiente de desenvolvimento.
RESEND_API_KEY=""
# Remetente: com a conta verificada na Resend use algo como "Carmix Nails <no-reply@oseudominio.cv>"
MAIL_FROM="Carmix Nails <onboarding@resend.dev>"
# Destinatário dos avisos internos (novas marcações). Vazio = e-mail da marca nas configurações.
MAIL_ADMIN_TO=""

# Ambiente de execução (produção: "production")
NODE_ENV="development"